# =============================================================================
# OpenWRT SSH MCP Server - Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Router SSH Connection
# -----------------------------------------------------------------------------
OPENWRT_HOST=192.168.1.1
OPENWRT_PORT=22
OPENWRT_USER=root

# -----------------------------------------------------------------------------
# Authentication (Choose ONE method)
# -----------------------------------------------------------------------------
# Option 1: Password-based (Not recommended for production)
OPENWRT_PASSWORD=

# Option 2: SSH Key-based (RECOMMENDED)
# Generate with: ssh-keygen -t ed25519 -f ~/.ssh/openwrt_router
# Copy to router: ssh-copy-id -i ~/.ssh/openwrt_router.pub root@192.168.1.1
# Windows example: C:\Users\YourUser\.ssh\openwrt_router
# Linux example: /home/youruser/.ssh/openwrt_router
OPENWRT_KEY_FILE=

# -----------------------------------------------------------------------------
# SSH Connection Settings
# -----------------------------------------------------------------------------
SSH_TIMEOUT=30
SSH_KEEPALIVE_INTERVAL=15

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# Enable command validation whitelist (HIGHLY RECOMMENDED)
ENABLE_COMMAND_VALIDATION=true

# Enable audit logging of all commands
ENABLE_AUDIT_LOGGING=true
LOG_FILE=openwrt_mcp.log

# -----------------------------------------------------------------------------
# Local OpenAI-compatible Endpoint (for openwrt-mcp-chat)
# -----------------------------------------------------------------------------
# Point this at any OpenAI-compatible API (Ollama, LM Studio, vLLM, LocalAI, etc.)
# Examples:
#   Ollama:    http://localhost:11434/v1    (api_key can be "ollama")
#   LM Studio: http://localhost:1234/v1     (api_key can be "lm-studio")
#   vLLM:      http://localhost:8000/v1
#   LocalAI:   http://localhost:8080/v1
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen3:8b
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.0

# =============================================================================
# Setup Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Edit OPENWRT_HOST with your router's IP
# 3. Set up SSH key authentication (recommended) or use password
# 4. Test connection: docker-mcp.ps1 test
# 5. For chat mode: openwrt-mcp-chat (configure OPENAI_* vars above)
# =============================================================================
